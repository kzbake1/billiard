{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/demo.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:name",
      "destination": "/api/og?n=:name"
    },
    {
      "source": "/t/:id",
      "destination": "/api/t?id=:id"
    },
    {
      "source": "/((?!api/|.*\\.).+)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/og.mjs": {
      "includeFiles": "{og/**,logo-white.svg,pattern-blue.svg}"
    },
    "api/t.js": {
      "includeFiles": "index.html"
    }
  }
}